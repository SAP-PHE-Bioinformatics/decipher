     rule ivar_HCV_core_consensus:
          input:
               bam = "{sample}/shcver/shcver_output/{sample}_remap.bam",
               core_local = rules.locate_core.output
          output:
               fasta = "HCV_core_consensus/{sample}_core.consensus.fa",
