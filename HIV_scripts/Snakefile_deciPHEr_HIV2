if config["HIV"]:
     rule reporting_conf:
          input:
               rules.HIV_QC.output
          output:
               "QC_HIV_reporting_config.yaml"
          run:
               qc_sum = pd.read_csv(f"{input}", delimiter='\t', header=0) 
               new_column_names = ['SampleID','wgs_cov','wgs_gc','wgs_dup','SampleID2','wgs_min','wgs_mean','wgs_median','wgs_max','SampleID3','pol_cov','pol_gc','pol_dup','SampleID4','pol_min','pol_mean','pol_median','pol_max']
               qc_sum.columns = new_column_names
               # filter based on conditions requiring 100% coverage of pol, with 100x mean depth and 20x minimum depth
               print(qc_sum)
               df_qc_pass = qc_sum.loc[(qc_sum['pol_cov']>=100) & (qc_sum['pol_min']>=20) & (qc_sum['pol_mean']>=100)]
               df_qc_fail = qc_sum.loc[(qc_sum['pol_cov']<100) & (qc_sum['pol_min']<20) & (qc_sum['pol_mean']<100)]
               # create a list of all sample ID's that pass QC
               qc_pass_samples = df_qc_pass['SampleID'].tolist()
               qc_fail_samples = df_qc_fail['SampleID'].tolist()
               # convert list into yaml format
               yaml_data = {
                    'HIV_PASS': qc_pass_samples,
                    'HIV_FAIL': qc_fail_samples
               }
               # dump the dictionary yaml content to write output QC_checkpoint_config.yaml file 
               yaml_output = yaml.dump(yaml_data, default_flow_style=False)

               with open(f"{output}", 'w') as yaml_file:
                    yaml_file.write(yaml_output)

