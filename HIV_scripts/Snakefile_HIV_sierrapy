#### target rules ####
if config["HIV_PASS"]:
    rule all:
        input:
            expand("HIV_StanfordDB/{sample}.0.json", sample=config["HIV_PASS"]),
            expand("HIV_StanfordDB/{sample}_report_data_intermediate.xlsx", sample=config["HIV_PASS"]),
            expand("HIV_StanfordDB/{sample}_report_data_final.xlsx", sample=config["HIV_PASS"])

### submit sequences to Stanford HIV Drug Resistance Database  ###
if config["HIV_PASS"]:
    rule sierrapy:
            input:
                fasta = "HIV_consensus/{sample}.consensus.fa"
            output:
                json = "HIV_StanfordDB/{sample}.0.json"
            params:
                json_name = "HIV_StanfordDB/{sample}.json" # this is required becuase the tool's output changes the name @_@
            conda: "sierrapy"
            shell:
                """
                sierrapy fasta {input.fasta} -o {params.json_name}
                """

### extract data from .json output and format into individual preliminary report ###
